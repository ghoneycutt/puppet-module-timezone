{
  "name": "ghoneycutt-timezone",
  "version": "4.0.0",
  "author": "ghoneycutt",
  "summary": "Manage system time zone",
  "license": "Apache-2.0",
  "source": "git://github.com/ghoneycutt/puppet-module-timezone.git",
  "project_page": "https://github.com/ghoneycutt/puppet-module-timezone",
  "issues_url": "https://github.com/ghoneycutt/puppet-module-timezone/issues",
  "dependencies": [
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 9.7.0 < 11.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": [
        "13"
      ]
    },
    {
      "operatingsystem": "RedHat",
      "operatingsystemrelease": [
        "8",
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "Rocky",
      "operatingsystemrelease": [
        "8",
        "9"
      ]
    },
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "22.04",
        "24.04",
        "26.04"
      ]
    }
  ],
  "requirements": [
    {
      "name": "openvox",
      "version_requirement": ">= 8.19.0 < 10.0.0"
    }
  ],
  "description": "Manage system time zone"
}
